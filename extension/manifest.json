{
  "manifest_version": 3,
  "name": "Chrome Eye",
  "version": "1.0",
  "description": "DeepSeek Harness side panel with shared context.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:3080/*",
    "http://127.0.0.1:3081/*"
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Open Chrome Eye"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    },
    {
      "matches": ["http://127.0.0.1:3080/*", "http://127.0.0.1:3081/*"],
      "js": ["composer-hook.js"],
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "options_page": "options.html"
}
